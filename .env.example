# Copy this file to .env and fill the values locally.
# Never commit real credentials.

IBIGFUN_ACCOUNT=
IBIGFUN_PASSWORD=

# OpenRouteService API key for foot-walking distance (https://openrouteservice.org/dev)
ORS_API_KEY=

# Optional Valhalla base URL for route-trial and route-benchmark.
# Leave blank to use the public FOSSGIS demo at https://valhalla1.openstreetmap.de.
# A VALHALLA_URL exported for one command overrides this file.
VALHALLA_URL=

# Notifier command invoked with the argv contract in docs/notifications.md.
# Defaults to `ai-notify`. If unset and no notifier is installed, the run still
# completes and writes the report; the notification is skipped with a notice.
NOTIFY_CMD=
